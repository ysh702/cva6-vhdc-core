proc required_env {name} {
    if {![info exists ::env($name)] || [string trim $::env($name)] eq ""} {
        error "Required environment variable $name is not set"
    }
    return [string trim $::env($name)]
}
proc optional_env {name default_value} {
    if {[info exists ::env($name)] && [string trim $::env($name)] ne ""} {
        return [string trim $::env($name)]
    }
    return $default_value
}
proc fatal {message} {
    puts stderr "FATAL: $message"
    exit 2
}
proc annotation_percent_from_verbose_report {text} {
    # Preserve the R13 read_saif -verbose parser as an independent lower-bound
    # signal when that report contains machine-readable percentages.
    # Use the minimum reported positive annotation/coverage value; choosing the
    # maximum could hide a poorly annotated material sub-block behind a 100%
    # top-level line.  Explicit "not annotated" percentages are excluded
    # because they are complements, not coverage values.
    set worst -1.0
    foreach line [split $text "\n"] {
        if {![regexp -nocase {(annotat|coverage)} $line]} { continue }
        if {[regexp -nocase {(not[ _-]*annotated|unannotated)} $line]} { continue }
        if {[regexp -nocase {([0-9]+[.]?[0-9]*)[ \t]*%} $line -> value]} {
            set numeric [expr {double($value)}]
            if {$numeric <= 0.0} { continue }
            if {$worst < 0.0 || $numeric < $worst} { set worst $numeric }
        }
    }
    return $worst
}
proc key_value_from_text {text wanted} {
    set value ""
    foreach line [split $text "\n"] {
        if {[regexp {^([^=]+)=(.*)$} $line -> key candidate] &&
            [string trim $key] eq $wanted} {
            set value [string trim $candidate]
        }
    }
    return $value
}
